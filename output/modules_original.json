    "module_code": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        html, body { margin: 0; padding: 0; }\n        * { box-sizing: border-box; }\n        body { font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; background:#ffffff; }\n\n        .uist-sponsor-section{\n            width: 100%;\n            background: #ffffff;\n            padding: 0;\n            margin: 0;\n        }\n\n        .uist-card{\n            width: 100%;\n            background: #ffffff;\n            border: 1px solid #e9e9e9;\n            border-radius: 18px;\n            padding: 0;\n            margin: 0;\n            overflow: hidden;\n        }\n\n        .uist-inner{\n            width: 100%;\n            padding: 34px 0 0 0;\n        }\n\n        .top-accent{\n            width: 92px;\n            height: 4px;\n            background: #b77a1f;\n            border-radius: 2px;\n            margin: 0 auto;\n        }\n\n        .tier-row{\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 14px;\n            margin-top: 34px;\n            color: #8a6a2a;\n            font-weight: 700;\n            letter-spacing: 0.18em;\n            font-size: 22px;\n        }\n\n        .tier-line{\n            height: 2px;\n            width: 240px;\n            background: #e7d7b8;\n            border-radius: 2px;\n        }\n\n        .tier-icon{\n            width: 26px;\n            height: 26px;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .logos{\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 120px;\n            padding: 44px 0 44px 0;\n        }\n\n        .logo-img{\n            height: 78px;\n            width: auto;\n            display: block;\n        }\n\n        .divider{\n            height: 1px;\n            background: #e9e9e9;\n            width: calc(100% - 120px);\n            margin: 0 auto;\n        }\n\n        .cta{\n            padding: 34px 0 44px 0;\n            text-align: center;\n            font-size: 28px;\n            line-height: 1.35;\n            color: #6b7280;\n        }\n\n        .cta strong{\n            color: #111111;\n            font-weight: 800;\n        }\n\n        .cta a{\n            color: #007a87;\n            text-decoration: underline;\n            text-underline-offset: 3px;\n        }\n\n        .ext{\n            display: inline-flex;\n            vertical-align: -3px;\n            margin-left: 6px;\n        }\n\n        .ext svg{\n            width: 22px;\n            height: 22px;\n            stroke: #007a87;\n        }\n\n        @media (max-width: 980px){\n            .tier-line{ width: 160px; }\n            .logos{ gap: 56px; padding: 36px 0; }\n            .logo-img{ height: 64px; }\n            .cta{ font-size: 22px; padding: 28px 18px 38px; }\n            .divider{ width: calc(100% - 48px); }\n        }\n\n        @media (max-width: 560px){\n            .tier-row{ font-size: 18px; }\n            .tier-line{ width: 110px; }\n            .logos{ flex-direction: column; gap: 22px; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"uist-sponsor-section\">\n        <div class=\"uist-card\">\n            <div class=\"uist-inner\">\n                <div class=\"top-accent\"></div>\n\n                <div class=\"tier-row\">\n                    <div class=\"tier-line\"></div>\n                    <span class=\"tier-icon\" aria-hidden=\"true\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                            <path d=\"M4 9.2 7.6 5h8.8L20 9.2l-8 10.3L4 9.2Z\" fill=\"#8a6a2a\"/>\n                            <path d=\"M7.6 5 12 9.2 16.4 5\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" opacity=\"0.9\"/>\n                            <path d=\"M4 9.2h16\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" opacity=\"0.9\"/>\n                        </svg>\n                    </span>\n                    <div style=\"display:flex;align-items:center;gap:0;\">\n                        <span>GOLD</span>\n                    </div>\n                    <div class=\"tier-line\"></div>\n                </div>\n\n                <div class=\"logos\">\n                    <img class=\"logo-img\" src=\"https://placehold.co/360x120/png?text=Adobe\" alt=\"Adobe logo in red with stylized A icon and the word Adobe\">\n                    <img class=\"logo-img\" src=\"https://placehold.co/420x120/png?text=AUTODESK\" alt=\"Autodesk logo in black with a geometric mark and the word AUTODESK\">\n                </div>\n\n                <div class=\"divider\"></div>\n\n                <div class=\"cta\">\n                    <strong>Interested in sponsoring UIST 2026?</strong>\n                    Check our\n                    <a href=\"#\" aria-label=\"Sponsor page (opens in a new tab)\">Sponsor page</a>\n                    <span class=\"ext\" aria-hidden=\"true\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M14 3h7v7\"></path>\n                            <path d=\"M10 14 21 3\"></path>\n                            <path d=\"M21 14v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6\"></path>\n                        </svg>\n                    </span>\n                    or contact\n                    <a href=\"#\" aria-label=\"sponsorship2026@uist.org (opens in a new tab)\">sponsorship2026@uist.org</a>\n                    <span class=\"ext\" aria-hidden=\"true\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M14 3h7v7\"></path>\n                            <path d=\"M10 14 21 3\"></path>\n                            <path d=\"M21 14v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6\"></path>\n                        </svg>\n                    </span>.\n                </div>\n            </div>\n        </div>\n    </div>\n</body>\n</html>\n"

ria-hidden=\"true\"></span>\n                    <div>Detroit, MI USA</div>\n                    <span class=\"dot\" aria-hidden=\"true\"></span>\n                    <a class=\"meta-link\" href=\"#\" aria-label=\"Renaissance Center\">Renaissance Center</a>\n                </div>\n            </div>\n\n            <div class=\"replay\" role=\"button\" tabindex=\"0\" aria-label=\"Replay video\">\n                <div class=\"icon\" aria-hidden=\"true\">\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\">\n                        <path d=\"M20 12a8 8 0 1 1-2.34-5.66\" stroke=\"white\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>\n                        <path d=\"M20 4v6h-6\" stroke=\"white\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                    </svg>\n                </div>\n                <div>Replay video</div>\n            </div>\n        </div>\n\n        <div class=\"ann-wrap\">\n            <div class=\"ann-card\">\n                <div class=\"ann-head\">\n                    <div class=\"megaphone\" aria-hidden=\"true\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n                            <path d=\"M4 10v4c0 .55.45 1 1 1h2l4 4v-8l-4 4H5c-.55 0-1-.45-1-1v-4c0-.55.45-1 1-1h2l4-4v8l-4-4H5c-.55 0-1 .45-1 1Z\" fill=\"#8a6a2a\" opacity=\".0\"/>\n                            <path d=\"M3 10v4c0 .55.45 1 1 1h2l7 4V5L6 9H4c-.55 0-1 .45-1 1Z\" fill=\"#8a6a2a\"/>\n                            <path d=\"M16 9.5c1.2 1.2 1.2 3.8 0 5\" stroke=\"#8a6a2a\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                            <path d=\"M18.5 7c2.6 2.6 2.6 7.4 0 10\" stroke=\"#8a6a2a\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                        </svg>\n                    </div>\n                    <div>ANNOUNCEMENTS</div>\n                </div>\n                <div class=\"ann-divider\"></div>\n                <div class=\"ann-item\">\n                    <div class=\"ann-left\">\n                        <div class=\"tri\" aria-hidden=\"true\">▶</div>\n                        <div class=\"ann-text\">\n                            <div class=\"ann-title\">Page Limit Reintroduced for UIST 2026 Papers</div>\n                            <div class=\"ann-desc\">This year we have decided to reintroduce a fixed page limit for papers. T...</div>\n                        </div>\n                    </div>\n                    <div class=\"ann-date\">February 2026</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        (function(){\n            const replay = document.querySelector('.replay');\n            const onActivate = () => {\n                replay.style.transform = 'translateY(1px)';\n                setTimeout(()=>replay.style.transform='translateY(0px)', 120);\n            };\n            replay.addEventListener('click', onActivate);\n            replay.addEventListener('keydown', (e)=>{ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); onActivate(); }});\n        })();\n    </script>\n</body>\n</html>\n"

fy-content:center;\n            background:rgba(255,255,255,.08);\n        }\n        .replay svg{display:block}\n\n        .ann-wrap{\n            width:100%;\n            padding:34px 0 44px 0;\n            background:transparent;\n        }\n        .ann-card{\n            width:min(980px, calc(100% - 120px));\n            margin-left:auto;\n            margin-right:auto;\n            background:rgba(255,255,255,.72);\n            border:1px solid rgba(0,0,0,.10);\n            border-radius:12px;\n            box-shadow:0 1px 0 rgba(0,0,0,.05);\n            overflow:hidden;\n        }\n        .ann-head{\n            display:flex;\n            align-items:center;\n            gap:12px;\n            padding:22px 26px 14px 26px;\n            color:#8a6a2a;\n            font-weight:700;\n            letter-spacing:2px;\n            font-size:20px;\n        }\n        .ann-head .megaphone{\n            width:22px;height:22px;\n            display:flex;\n            align-items:center;\n            justify-content:center;\n        }\n        .ann-divider{\n            height:1px;\n            background:rgba(0,0,0,.12);\n            margin:0 26px;\n        }\n        .ann-item{\n            display:flex;\n            align-items:flex-start;\n            justify-content:space-between;\n            gap:18px;\n            padding:22px 26px 26px 26px;\n        }\n        .ann-left{\n            display:flex;\n            gap:14px;\n            align-items:flex-start;\n            min-width:0;\n        }\n        .tri{\n            color:#1a8a9a;\n            font-size:18px;\n            line-height:26px;\n            margin-top:2px;\n        }\n        .ann-text{\n            min-width:0;\n        }\n        .ann-title{\n            font-size:22px;\n            font-weight:700;\n            color:#111;\n            line-height:1.2;\n            white-space:nowrap;\n            overflow:hidden;\n            text-overflow:ellipsis;\n            max-width:720px;\n        }\n